smart.id.vn {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	# Keycloak: chỉ mở realm hcos và tài nguyên tĩnh; KHÔNG mở /auth/admin và realm master.
	@kc path /auth/realms/hcos/* /auth/resources/*
	handle @kc {
		reverse_proxy 127.0.0.1:8081
	}
	@api path /fhir/* /api/* /healthz /readyz
	handle @api {
		reverse_proxy 127.0.0.1:8080
	}
	# Ứng dụng web (file tĩnh build từ apps/web, mount chỉ-đọc vào /srv/hcos-web). Không có script/style inline => CSP chặt.
	redir /app /app/ 308
	handle_path /app/* {
		root * /srv/hcos-web
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
			Referrer-Policy no-referrer
			X-Frame-Options DENY
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
		# File có hash trong tên: cache lâu. index.html (và mọi đường dẫn SPA): không cache để luôn lấy bản mới.
		@assets path_regexp ^/app-[0-9a-f]{12}\.(js|css)$
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path_regexp ^/app-[0-9a-f]{12}\.(js|css)$
		header @pages Cache-Control no-store
		try_files {path} /index.html
		file_server
	}
	# Trạng thái vận hành (chỉ OK/FAIL, không chi tiết) cho uptime check.
	handle /opsstatus {
		reverse_proxy 127.0.0.1:8090
	}
	handle {
		respond "not found" 404
	}
}
